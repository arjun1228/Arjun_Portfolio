# ==============================================================
# SERVER ENVIRONMENT VARIABLES (server/.env)
# ==============================================================
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=super_secret_jwt_key_portfolio_2026_dev_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=Admin@12345

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_TO=your_email@gmail.com

# Cloudinary Image Uploads (Optional - fallback to base64 Data URIs if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================
# CLIENT ENVIRONMENT VARIABLES (client/.env)
# ==============================================================
VITE_API_URL=http://localhost:5000/api
